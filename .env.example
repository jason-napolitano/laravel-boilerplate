# ---------------------------------------------------------
# general config
APP_NAME="Laravel Application"
APP_DESCRIPTION="A Laravel powered application boilerplate, used for building amazing applications"
APP_VERSION=1.0.0
APP_URL=http://localhost

# ---------------------------------------------------------
# app setup
APP_ENV=local
APP_KEY=
APP_ENABLE_PASSKEYS=false
APP_ENABLE_RESET_PASSWORD=false
APP_ENABLE_REGISTRATION=true

# ---------------------------------------------------------
# debugging
APP_DEBUG=true

# ---------------------------------------------------------
# authorization
APP_DEFAULT_ROLE=member

# ---------------------------------------------------------
# pagination
APP_DEFAULT_PAGINATION=10

# ---------------------------------------------------------
# locale
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# ---------------------------------------------------------
# sanctum
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

# ---------------------------------------------------------
# maintenance config
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# ---------------------------------------------------------
# PHP_CLI_SERVER_WORKERS=4

# ---------------------------------------------------------
# security
BCRYPT_ROUNDS=12

# logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------
# database
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# ---------------------------------------------------------
# sessions
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ---------------------------------------------------------
# boradcasting
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# ---------------------------------------------------------
# caching
CACHE_STORE=database
# CACHE_PREFIX=

# memcache
MEMCACHED_HOST=127.0.0.1

# redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------
# mailer
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=25
MAIL_USERNAME=dummy
MAIL_PASSWORD=password
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="dummy@localhost"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------
# aws
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------
# vite
VITE_APP_NAME="${APP_NAME}"
VITE_APP_DEFAULT_ROLE="${APP_DEFAULT_ROLE}"
